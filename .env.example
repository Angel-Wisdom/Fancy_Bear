# Suraksha 2.0 — Environment Variables Template
# Copy this file to `.env` and edit before deploying.

# ── JWT / Auth ─────────────────────────────────────────────
# Set AUTH_DISABLED=true ONLY for local development without JWT.
# Leave false (the default) for any deployment where security matters.
AUTH_DISABLED=false

# Strong, random secret used to sign JWT access tokens.
# Generate with:  openssl rand -hex 32
JWT_SECRET=please-change-me-to-a-32-byte-hex-string

# ── Crypto (HMAC + AES) ────────────────────────────────────
# Used by server/engines/crypto-engine.js to HMAC-sign verification
# reports and to derive the AES-256-CBC key for at-rest encryption.
AES_SECRET=please-change-me-to-a-different-32-byte-hex-string
HMAC_SECRET=please-change-me-to-yet-another-32-byte-hex-string

# ── Aadhaar masked storage ─────────────────────────────────
# Salt mixed into the SHA-256 hash of the full Aadhaar number before
# it is stored in customers.aadhaar_hash. The full number is never
# persisted — only the last 4 digits + this salted hash.
AADHAAR_HASH_SALT=please-change-me-to-a-unique-salt-value

# ── Service wiring (Docker overrides these in docker-compose.yml) ──
PORT=3001
AADHAAR_SERVICE_HOST=127.0.0.1
AADHAAR_SERVICE_PORT=5000
SURAKSHA_DB_PATH=server/data/suraksha.db

# ── Client (Vite) ──────────────────────────────────────────
VITE_API_TARGET=http://localhost:3001
VITE_AUTH_DISABLED=false
